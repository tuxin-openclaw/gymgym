{
  "name": "gymgym",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev.mjs",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc -b && tsc -p server && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "preview": "vite preview",
    "data": "node scripts/build-exercises.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-auth": "^1.7.19",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
